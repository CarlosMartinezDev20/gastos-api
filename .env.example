# Copy to .env (git-ignored). Never commit real values.

# ─── Database: Supabase Postgres (Settings → Database → Connect) ───
# Session pooler (port 5432): IPv4, keeps prepared statements, fits a
# long-running server like this one (Render). The direct db.<ref>.supabase.co
# host is IPv6-only on the free plan. connection_limit keeps the API well
# under the free pooler's pool size. Local development can point both at a
# local Postgres instead, e.g. postgresql://postgres@localhost:5432/gastos_db
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=20&connect_timeout=30"
# Used by `prisma migrate` (same session pooler).
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"

# ─── Supabase Auth (Settings → API Keys) ───
# Access tokens are checked against this project's public keys (JWKS).
SUPABASE_URL="https://<project-ref>.supabase.co"
# Public key, safe in clients; the API uses it to confirm a password.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SECRET: server only, never in the app or in git. Deletes accounts and
# checks that a new account still exists. Required when NODE_ENV=production.
SUPABASE_SECRET_KEY=""

NODE_ENV=development
# The Flutter app uses http://localhost:3001 when run with
# --dart-define=API_BASE_URL=http://localhost:3001
PORT=3001
# Comma-separated; `http://localhost:*` allows any local port. Required in production.
CORS_ORIGIN="http://localhost:*"

# Seed only: create the demo accounts (Supabase Auth users) and their data.
# Needs SUPABASE_SECRET_KEY; refused in production.
SEED_DEMO_USERS=false
