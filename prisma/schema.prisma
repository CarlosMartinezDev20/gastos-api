datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  DIGITAL
}

enum CardBrand {
  VISA
  MASTERCARD
  AMEX
  OTHER
}

model User {
  id             String                 @id @default(uuid())
  name           String
  email          String                 @unique
  password       String
  avatarUrl      String?
  darkMode       Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  categories     Category[]
  transactions   Transaction[]
  savingsGoals   SavingsGoal[]
  budgets        Budget[]
  recurring      RecurringTransaction[]
  paymentMethods PaymentMethod[]
  cardPayments   CardPayment[]
}

model Category {
  id           String                 @id @default(uuid())
  name         String
  icon         String
  type         TransactionType
  isDefault    Boolean                @default(false)
  userId       String?
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]

  @@index([userId])
}

// Monthly spending limit a user sets on an expense category.
model Budget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}

model Transaction {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category              @relation(fields: [categoryId], references: [id])
  title           String
  amount          Decimal               @db.Decimal(12, 2)
  type            TransactionType
  date            DateTime              @default(now())
  // Set on goal contributions; deleting the goal deletes them and returns the money to the balance.
  goalId          String?
  goal            SavingsGoal?          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  // Set when generated by a recurring rule; kept if the rule is deleted.
  recurringId     String?
  recurring       RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  // How it was paid (the user's wallet); kept as null if the method is deleted.
  paymentMethodId String?
  paymentMethod   PaymentMethod?        @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  // Free reference, e.g. the generation code of a scanned electronic invoice.
  reference       String?

  // Every list, budget and statement query filters by user and date range.
  @@index([userId, date])
  @@index([categoryId])
  @@index([goalId])
  @@index([paymentMethodId])
}

// A card or other way of paying, for the user's wallet. Never the card
// number: only its last four digits, to tell cards apart.
model PaymentMethod {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         PaymentMethodType
  // Card-only fields (null for cash and digital wallets).
  brand        CardBrand?
  last4        String?
  bank         String?
  // Key of the card color chosen in the app.
  color        String
  // Credit-card-only fields: limit, statement closing day and payment due
  // day (1–31, clamped to short months).
  creditLimit  Decimal?               @db.Decimal(12, 2)
  statementDay Int?
  dueDay       Int?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  transactions Transaction[]
  recurring    RecurringTransaction[]
  // Payments to this credit card, and payments made from this method.
  payments     CardPayment[]          @relation("CardPayments")
  paidFrom     CardPayment[]          @relation("PaidFrom")

  @@index([userId])
}

model SavingsGoal {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Decimal       @db.Decimal(12, 2)
  savedAmount   Decimal       @default(0) @db.Decimal(12, 2)
  icon          String
  bgColor       String
  iconColor     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  contributions Transaction[]

  @@index([userId])
}

// A movement that repeats every week or month. Due occurrences are created as
// transactions when the user's movements or balance are read.
model RecurringTransaction {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title           String
  amount          Decimal             @db.Decimal(12, 2)
  type            TransactionType
  frequency       RecurrenceFrequency
  // Day of the month of the first occurrence, kept for short months.
  anchorDay       Int
  nextDate        DateTime
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  transactions    Transaction[]
  // Copied to the movements it creates; null if the method is deleted.
  paymentMethodId String?
  paymentMethod   PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// A payment to a credit card. Not an expense: the purchases already were,
// so it doesn't touch the balance; it lowers what is owed on the card.
model CardPayment {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethodId String
  paymentMethod   PaymentMethod  @relation("CardPayments", fields: [paymentMethodId], references: [id], onDelete: Cascade)
  // Where the money came from (a debit card, cash…), if the user says.
  fromMethodId    String?
  fromMethod      PaymentMethod? @relation("PaidFrom", fields: [fromMethodId], references: [id], onDelete: SetNull)
  amount          Decimal        @db.Decimal(12, 2)
  date            DateTime       @default(now())
  createdAt       DateTime       @default(now())

  @@index([paymentMethodId])
  @@index([userId])
}
