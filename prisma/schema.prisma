datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  DIGITAL
}

enum CardBrand {
  VISA
  MASTERCARD
  AMEX
  OTHER
}

model User {
  id             String                 @id @default(uuid())
  name           String
  email          String                 @unique
  password       String
  avatarUrl      String?
  darkMode       Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  categories     Category[]
  transactions   Transaction[]
  savingsGoals   SavingsGoal[]
  budgets        Budget[]
  recurring      RecurringTransaction[]
  paymentMethods PaymentMethod[]
}

model Category {
  id           String                 @id @default(uuid())
  name         String
  icon         String
  type         TransactionType
  isDefault    Boolean                @default(false)
  userId       String?
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]

  @@index([userId])
}

// Monthly spending limit a user sets on an expense category.
model Budget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}

model Transaction {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category              @relation(fields: [categoryId], references: [id])
  title           String
  amount          Float
  type            TransactionType
  date            DateTime              @default(now())
  // Set on goal contributions; deleting the goal deletes them and returns the money to the balance.
  goalId          String?
  goal            SavingsGoal?          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  // Set when generated by a recurring rule; kept if the rule is deleted.
  recurringId     String?
  recurring       RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  // How it was paid (the user's wallet); kept as null if the method is deleted.
  paymentMethodId String?
  paymentMethod   PaymentMethod?        @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  // Free reference, e.g. the generation code of a scanned electronic invoice.
  reference       String?

  @@index([userId])
  @@index([categoryId])
  @@index([goalId])
  @@index([paymentMethodId])
}

// A card or other way of paying, for the user's wallet. Never the card
// number: only its last four digits, to tell cards apart.
model PaymentMethod {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         PaymentMethodType
  // Card-only fields (null for cash and digital wallets).
  brand        CardBrand?
  last4        String?
  bank         String?
  // Key of the card color chosen in the app.
  color        String
  // Credit-card-only fields: limit, statement closing day and payment due
  // day (1–31, clamped to short months).
  creditLimit  Float?
  statementDay Int?
  dueDay       Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions Transaction[]

  @@index([userId])
}

model SavingsGoal {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  savedAmount   Float         @default(0)
  icon          String
  bgColor       String
  iconColor     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  contributions Transaction[]

  @@index([userId])
}

// A movement that repeats every week or month. Due occurrences are created as
// transactions when the user's movements or balance are read.
model RecurringTransaction {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title        String
  amount       Float
  type         TransactionType
  frequency    RecurrenceFrequency
  // Day of the month of the first occurrence, kept for short months.
  anchorDay    Int
  nextDate     DateTime
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions Transaction[]

  @@index([userId])
}
